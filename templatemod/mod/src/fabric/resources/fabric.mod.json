{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.psydvl.mc.example.fabric.ExampleModFabric"]
  },
  "mixins": ["${mod_id}.mixins.json"],
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "${minecraft_predicate}",
    "java": ">=${java_version}"
  }
}
